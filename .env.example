# ============================================================================
# Variáveis de ambiente (copie para `.env` — NUNCA versione o `.env`)
# Todas são OPCIONAIS: sem elas o site funciona normalmente.
# No Vite, apenas variáveis com prefixo VITE_ chegam ao navegador.
# Use somente chaves PÚBLICAS/restritas por domínio aqui.
# ============================================================================

# Google Analytics 4 — ex.: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google Maps — só é necessário se você migrar do embed público para a
# Maps JavaScript API. Restrinja a chave por domínio no Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Google Reviews — Place ID do perfil da empresa no Google.
# A leitura das avaliações exige um backend/serviço autorizado (ver README).
VITE_GOOGLE_PLACE_ID=
